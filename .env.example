# Database Connection URL (PostgreSQL / Vercel Storage Postgres / Neon)
# On Vercel, this is automatically provided when connecting a Vercel Postgres store (or you can use POSTGRES_PRISMA_URL)
DATABASE_URL="postgresql://username:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Postgres direct/pooled URLs (optional, auto-injected by Vercel Postgres)
# POSTGRES_PRISMA_URL="postgres://..."
# POSTGRES_URL_NON_POOLING="postgres://..."

# JWT Authentication (Change this to a strong secret in production, e.g., openssl rand -base64 32)
JWT_SECRET="your-secret-key-change-in-production"

# Application Base URL (e.g. https://your-project.vercel.app in production)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional: Google Gemini API Key for AI Syllabus Audit
GEMINI_API_KEY=""
